# ============================================================
# StockPilot — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Flask / Backend ----
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# SQLite (default, file stored in backend/data/)
DATABASE_URL=sqlite:///stockpilot.db

# PostgreSQL example (uncomment for production)
# DATABASE_URL=postgresql://user:password@host:5432/stockpilot

FLASK_DEBUG=False

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:5000
